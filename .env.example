# ============================================================
# Database — Prisma Postgres
# ============================================================

# Prisma Postgres protocol URL (used by Prisma CLI)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# Direct PostgreSQL connection (used by app runtime and seed)
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ============================================================
# Auth
# ============================================================
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_SITE_URL="https://conskins.com"

# Public base URL of this deployment. Steam OpenID uses it to build the
# realm and return_to callback, so it MUST match the origin users hit
# (no trailing slash). Locally use http://localhost:9997; in production set
# your real domain, e.g. https://conskins.com. On Vercel, VERCEL_URL is
# used automatically as a fallback if these are unset.
APP_URL="http://localhost:9997"
NEXT_PUBLIC_APP_URL="http://localhost:9997"

# ============================================================
# Steam
# ============================================================
# Steam Web API key from https://steamcommunity.com/dev/apikey — used to fetch
# player profile summaries (persona name, avatar) after OpenID sign-in. Sign-in
# still works without it, but profiles degrade to a bare SteamID64.
STEAM_API_KEY="your-steam-web-api-key"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/conskins.official/"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/conskins/"

# ============================================================
# Resend — transactional emails (domain must be verified in Resend)
# ============================================================
RESEND_API_KEY="re_xxxxx"
RESEND_FROM_EMAIL="ConSkins <info@conskins.com>"
RESEND_REPLY_TO="info@conskins.com"

# ============================================================
# SIH (SkinsInHood) — skin purchase & delivery integration
# https://docs.sih.app/guide/
# ============================================================
SIH_API_KEY="your-sih-api-key"
SIH_API_BASE_URL="https://api.sih.market/api/v1"
# Shared secret to verify SIH webhook callbacks (set same value in SIH dashboard)
SIH_WEBHOOK_SECRET="your-sih-webhook-secret"

# ============================================================
# Company credentials — rendered in footer, policies, contact
# ============================================================
NEXT_PUBLIC_COMPANY_NAME="CONDEO LTD"
NEXT_PUBLIC_COMPANY_NUMBER="17225871"
NEXT_PUBLIC_COMPANY_ADDRESS="Dept 6790, 196 High Road, Wood Green, London, United Kingdom, N22 8HH"
NEXT_PUBLIC_COMPANY_EMAIL="info@conskins.com"
